# Local dev environment -- regenerate with:
#   python -m venv .venv && .venv\Scripts\python.exe -m pip install -r requirements.txt
.venv/

# Self-contained embeddable Python bundled into the installer -- see README
# ("rebuild the runtime + installer") for how to set this back up.
runtime_build/

# Built installer output (multi-GB, regenerate via Inno Setup)
installer_output/

# Python bytecode cache
__pycache__/
*.pyc

# Downloaded SAM2 model weights (~150MB) -- auto-downloaded on first AI
# Select use and cached here; not source, no need to version it.
sam2_b.pt

# Editor/OS cruft
.vscode/
.idea/
Thumbs.db
.DS_Store
